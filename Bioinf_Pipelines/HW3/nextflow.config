/*
 * HW3 Nextflow pipeline configuration
 * Homework 3 – Modules, configuration and containers
 */

manifest {
    name        = 'HW3-bacterial-wgs'
    author      = 'EugeniaArth'
    description = 'QC, trimming, mapping, coverage and variant calling pipeline'
    mainScript  = 'main.nf'
    version     = '1.0.0'
    nextflowVersion = '>=23.04.0'
}

includeConfig 'conf/base.config'

profiles {
    standard {
        process.executor = 'local'
    }

    local {
        includeConfig 'conf/local.config'
        process.executor = 'local'
    }

    cluster {
        includeConfig 'conf/cluster.config'
    }

    docker {
        includeConfig 'conf/container.config'
        docker.enabled = true
        process.executor = 'local'
    }

    singularity {
        includeConfig 'conf/container.config'
        singularity.enabled = true
        docker.enabled = false
        process.executor = 'local'
    }
}

params.help = false

if (params.help) {
    log.info """
    HW3 bacterial WGS pipeline
    ==========================

    Required:
      --reads       Paired-end reads glob, e.g. 'data/*_{1,2}.fastq'
      --reference   Reference FASTA file
      --outdir      Output directory (default: HW3/results)

    Optional:
      --threads     Number of CPUs (default: 4)
      --conda_env   Path to local conda env (local profile)
      --docker_registry  Docker Hub prefix (default: eugeniaarth)

    Profiles:
      -profile local       current machine + conda env path
      -profile cluster      SLURM cluster + conda yml files
      -profile docker       Docker containers
      -profile singularity  Singularity containers

    Example (auto-install tools from yml, no setup needed):
      nextflow run HW3/main.nf -profile local \\
        --reads '/path/to/*_{1,2}.fastq' \\
        --reference /path/to/ref.fasta

    Example (one shared conda env — run bin/setup_env.sh first):
      ./HW3/bin/setup_env.sh hw3
      nextflow run HW3/main.nf -profile local \\
        --reads '/path/to/*_{1,2}.fastq' \\
        --reference /path/to/ref.fasta \\
        --conda_env ~/miniconda3/envs/hw3
    """
    exit 0
}
