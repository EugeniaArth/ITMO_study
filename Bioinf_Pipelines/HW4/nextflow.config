manifest {
    name            = 'HW4-multi-sample'
    description     = 'HW3 pipeline + CSV samplesheet, country groups, variant filtering'
    mainScript      = 'main.nf'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}

includeConfig 'conf/base.config'

profiles {
    standard {
        process.executor = 'local'
    }

    local {
        includeConfig 'conf/local.config'
        process.executor = 'local'
    }

    cluster {
        includeConfig 'conf/cluster.config'
    }

    docker {
        includeConfig 'conf/container.config'
        docker.enabled = true
        process.executor = 'local'
    }

    singularity {
        includeConfig 'conf/container.config'
        singularity.enabled = true
        docker.enabled = false
        process.executor = 'local'
    }
}

params.help = false
cleanup = true

if (params.help) {
    log.info """
    HW4 multi-sample pipeline
    =========================

    Required:
      --samplesheet   CSV with columns: sample, country, fastq_1, fastq_2
      --reference     Reference FASTA

    Optional:
      --outdir        Output directory
      --threads       CPUs (default: 4)
      --min_qual      Min QUAL for variant filter (default: 30)
      --conda_env     Path to conda env (local profile)

    Test FILTER_VARIANTS stub without running tools:
      nextflow run main.nf -profile local -stub-run

    Full run:
      nextflow run main.nf -profile local \\
        --samplesheet assets/samplesheet.csv \\
        --reference /path/to/ref.fasta
    """
    exit 0
}
